# Скопируйте в .env и заполните своими значениями.
# .env не должен попадать в git.

POSTGRES_PASSWORD=change-me

STRATZ_API_TOKEN=change-me

TELEGRAM_TOKEN=change-me
TELEGRAM_SECRET_TOKEN=change-me
# Должен быть https и совпадать с маршрутом /bot в Caddyfile
TELEGRAM_WEBHOOK_URL=https://api.example.com/bot

# Origin фронтенда без пути, например https://username.github.io
# Несколько значений — через запятую.
CORS_ORIGINS=https://username.github.io
